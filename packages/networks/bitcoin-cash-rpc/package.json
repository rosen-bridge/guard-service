{
  "name": "@rosen-chains/bitcoin-cash-rpc",
  "version": "0.0.0",
  "description": "Bounded wallet-backed Bitcoin Cash Node RPC provider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/guard-service.git",
    "directory": "packages/networks/bitcoin-cash-rpc"
  },
  "license": "MIT",
  "author": "A. Shannon",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "release": "npm run test -- --run && npm run clean && npm run build && npm publish --access public",
    "type-check": "tsc --noEmit",
    "prettify": "prettier --write . --ignore-path ../../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../../.gitignore"
  },
  "dependencies": {
    "@bitauth/libauth": "3.0.0",
    "@rosen-bridge/address-codec": "^2.1.0",
    "@rosen-bridge/rosen-extractor": "^12.1.2",
    "@rosen-chains/abstract-chain": "17.0.0",
    "@rosen-chains/bitcoin-cash": "0.0.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
